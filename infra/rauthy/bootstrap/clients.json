[
  {
    "id": "authlink-local",
    "name": "AuthLink Local",
    "redirect_uris": [
      "http://localhost:8787/api/v1/authlink/oidc/callback"
    ],
    "enabled": true,
    "flows_enabled": [
      "authorization_code",
      "refresh_token"
    ],
    "access_token_alg": "EdDSA",
    "id_token_alg": "EdDSA",
    "auth_code_lifetime": 60,
    "access_token_lifetime": 3600,
    "scopes": [
      "openid",
      "profile",
      "email"
    ],
    "default_scopes": [
      "openid",
      "profile",
      "email"
    ],
    "force_mfa": false
  }
]
