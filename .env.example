# AuthLink runtime profile
AUTHLINK_ENV=development
AUTHLINK_GATEWAY_ADDR=127.0.0.1:8787
AUTHLINK_WEB_URL=http://127.0.0.1:5173
AUTHLINK_DEFAULT_TENANT_ID=00000000-0000-7000-8000-000000000001

# Development only. Production refuses to start without OpenFGA config.
AUTHLINK_POLICY_DEV_BYPASS=true

# OpenFGA. After creating a store/model, fill these values.
OPENFGA_API_URL=http://127.0.0.1:8080
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
# OPENFGA_API_TOKEN=

# Web client. Cookie-bearing requests require this origin to match AUTHLINK_WEB_URL.
VITE_AUTHLINK_API=http://127.0.0.1:8787/api/v1

# PostgreSQL authority.
DATABASE_URL=postgres://authlink:authlink_dev_only@127.0.0.1:54329/authlink

# Rauthy/OIDC. AuthLink uses Authorization Code + PKCE as a BFF:
# provider tokens stay server-side and the browser receives only an opaque HttpOnly session cookie.
AUTHLINK_OIDC_ISSUER=http://127.0.0.1:8085
AUTHLINK_OIDC_CLIENT_ID=authlink-local
AUTHLINK_OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/v1/authlink/oidc/callback
AUTHLINK_OIDC_SCOPES=openid profile email
# Public PKCE clients do not need a client secret. If a confidential-client profile is added later,
# keep the secret in the deployment secret manager, never in source control.
# AUTHLINK_OIDC_CLIENT_SECRET=
